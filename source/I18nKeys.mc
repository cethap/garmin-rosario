import Toybox.Lang;

// Generated by scripts/gen-i18n.py from i18n/eng.json, i18n/spa.json, i18n/fre.json, i18n/lat.json.
// Do not edit: change those files and run python3 scripts/gen-i18n.py.
//
// A text's key is its table's number times TABLE_KEYS plus its index in the table, so a lookup knows
// which table to load (I18n.mc). Only the glance table's keys and resources are glance-annotated: the
// glance can load no other table.
(:glance)
module I18n {
    // The languages, in the order of the tables in tableId.
    enum Language {
        ENG,
        SPA,
        FRE,
        LAT
    }

    const LANGUAGE_COUNT = 4;
    const TABLE_KEYS = 256;

    // Table 0: "glance" in i18n/<lang>.json.
    enum {
        SetPluralJoyful = 0,
        SetPluralSorrowful = 1,
        SetPluralGlorious = 2,
        SetPluralLuminous = 3,
        GlanceNotStarted = 4,
        GlanceInProgress = 5,
        GlanceMystery = 6,
        GlanceDone = 7,
        PrayerSalve = 8
    }

    // The glance table of a language.
    function glanceTable(language as Language) as ResourceId {
        var ids = [Rez.JsonData.GlanceEng, Rez.JsonData.GlanceSpa, Rez.JsonData.GlanceFre, Rez.JsonData.GlanceLat] as Array<ResourceId>;
        return ids[language as Number];
    }
}

// The other tables, which only the full-screen widget loads.
module I18n {
    const TABLE_COUNT = 7;

    // Table 1: "ui" in i18n/<lang>.json.
    enum {
        PrayerCreed = 256,
        PrayerOurFather = 257,
        PrayerHailMary = 258,
        PrayerGloryBe = 259,
        PrayerFatima = 260,
        PrayerNumber = 261,
        OpeningTitle = 262,
        ClosingTitle = 263,
        SetTitleJoyful = 264,
        SetTitleSorrowful = 265,
        SetTitleGlorious = 266,
        SetTitleLuminous = 267,
        MysteryTitle = 268,
        Ordinal1 = 269,
        Ordinal2 = 270,
        Ordinal3 = 271,
        Ordinal4 = 272,
        Ordinal5 = 273,
        SetSingularJoyful = 274,
        SetSingularSorrowful = 275,
        SetSingularGlorious = 276,
        SetSingularLuminous = 277,
        ResetPrompt = 278,
        MenuRead = 279,
        MenuLanguage = 280,
        MenuReset = 281,
        LanguageAutomatic = 282
    }

    // Table 2: "mysteries" in i18n/<lang>.json.
    enum {
        Mystery1 = 512,
        Mystery2 = 513,
        Mystery3 = 514,
        Mystery4 = 515,
        Mystery5 = 516,
        Mystery6 = 517,
        Mystery7 = 518,
        Mystery8 = 519,
        Mystery9 = 520,
        Mystery10 = 521,
        Mystery11 = 522,
        Mystery12 = 523,
        Mystery13 = 524,
        Mystery14 = 525,
        Mystery15 = 526,
        Mystery16 = 527,
        Mystery17 = 528,
        Mystery18 = 529,
        Mystery19 = 530,
        Mystery20 = 531
    }

    // Table 3: "quotesJoyful" in i18n/<lang>.json.
    enum {
        Quote1 = 768,
        Ref1 = 769,
        Quote2 = 770,
        Ref2 = 771,
        Quote3 = 772,
        Ref3 = 773,
        Quote4 = 774,
        Ref4 = 775,
        Quote5 = 776,
        Ref5 = 777
    }

    // Table 4: "quotesSorrowful" in i18n/<lang>.json.
    enum {
        Quote6 = 1024,
        Ref6 = 1025,
        Quote7 = 1026,
        Ref7 = 1027,
        Quote8 = 1028,
        Ref8 = 1029,
        Quote9 = 1030,
        Ref9 = 1031,
        Quote10 = 1032,
        Ref10 = 1033
    }

    // Table 5: "quotesGlorious" in i18n/<lang>.json.
    enum {
        Quote11 = 1280,
        Ref11 = 1281,
        Quote12 = 1282,
        Ref12 = 1283,
        Quote13 = 1284,
        Ref13 = 1285,
        Quote14 = 1286,
        Ref14 = 1287,
        Quote15 = 1288,
        Ref15 = 1289
    }

    // Table 6: "quotesLuminous" in i18n/<lang>.json.
    enum {
        Quote16 = 1536,
        Ref16 = 1537,
        Quote17 = 1538,
        Ref17 = 1539,
        Quote18 = 1540,
        Ref18 = 1541,
        Quote19 = 1542,
        Ref19 = 1543,
        Quote20 = 1544,
        Ref20 = 1545
    }

    // The resource of a table (0..TABLE_COUNT - 1) in a language: every language's tables in turn.
    function tableId(table as Number, language as Language) as ResourceId {
        var ids = [
            Rez.JsonData.GlanceEng,
            Rez.JsonData.UiEng,
            Rez.JsonData.MysteriesEng,
            Rez.JsonData.QuotesJoyfulEng,
            Rez.JsonData.QuotesSorrowfulEng,
            Rez.JsonData.QuotesGloriousEng,
            Rez.JsonData.QuotesLuminousEng,
            Rez.JsonData.GlanceSpa,
            Rez.JsonData.UiSpa,
            Rez.JsonData.MysteriesSpa,
            Rez.JsonData.QuotesJoyfulSpa,
            Rez.JsonData.QuotesSorrowfulSpa,
            Rez.JsonData.QuotesGloriousSpa,
            Rez.JsonData.QuotesLuminousSpa,
            Rez.JsonData.GlanceFre,
            Rez.JsonData.UiFre,
            Rez.JsonData.MysteriesFre,
            Rez.JsonData.QuotesJoyfulFre,
            Rez.JsonData.QuotesSorrowfulFre,
            Rez.JsonData.QuotesGloriousFre,
            Rez.JsonData.QuotesLuminousFre,
            Rez.JsonData.GlanceLat,
            Rez.JsonData.UiLat,
            Rez.JsonData.MysteriesLat,
            Rez.JsonData.QuotesJoyfulLat,
            Rez.JsonData.QuotesSorrowfulLat,
            Rez.JsonData.QuotesGloriousLat,
            Rez.JsonData.QuotesLuminousLat
        ] as Array<ResourceId>;
        return ids[(language as Number) * TABLE_COUNT + table];
    }
}
